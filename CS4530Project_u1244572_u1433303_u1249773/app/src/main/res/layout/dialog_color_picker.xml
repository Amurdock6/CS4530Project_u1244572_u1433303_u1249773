<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/preview_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Color Preview:"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorOnSurface" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:padding="1dp"
            android:background="@drawable/color_preview_border">

            <View
                android:id="@+id/previewColorView"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="#FFFFFFFF"
                android:contentDescription="@string/color_preview_desc" />

        </FrameLayout>

        <!-- Color wheel in the center -->
        <com.example.androidracedash.view.SafeColorPickerView
            android:id="@+id/colorPickerView"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginBottom="16dp" />

        <!-- Live preview square just below the wheel -->

        <!-- Brightness slider label -->

        <!-- Brightness slider itself -->
        <TextView
            android:id="@+id/brightnessLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="B: 100 %"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorOnSurface" />

        <com.example.androidracedash.view.SafeBrightnessSlideBar
            android:id="@+id/brightnessSlideBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            app:selector_BrightnessSlider="@drawable/color_picker_slider_selector" />

        <!-- Alpha slider label -->
        <TextView
            android:id="@+id/alphaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="A: 100 %"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorOnSurface" />

        <!-- Alpha slider itself -->
        <com.example.androidracedash.view.SafeAlphaSlideBar
            android:id="@+id/alphaSlideBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            app:selector_AlphaSlideBar="@drawable/color_picker_slider_selector" />

        <!-- Hint positioned above the hex field -->
        <TextView
            android:id="@+id/hexHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/hex_color_hint"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorOnSurface" />

        <!-- Hex entry field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@null"
            android:textColorHint="?attr/colorOnSurface"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="?attr/colorOnSurface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingTop="10dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
